{
  "name": "@task-manager/shared",
  "version": "2.0.0",
  "private": true,
  "description": "Esquemas Zod y tipos compartidos entre el cliente y el servidor",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "exports": {
