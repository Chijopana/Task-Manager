# Copia este archivo a .env y rellena los valores. El .env nunca se sube.

# Cadena de conexión a MongoDB (Atlas o local)
MONGO_URI=mongodb://localhost:27017/task-manager

# Clave con la que se firman los tokens. Mínimo 32 caracteres en producción.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazame-por-una-cadena-larga-y-aleatoria

# Duración del token de sesión
JWT_EXPIRES_IN=2h

# Puerto en el que escucha la API
PORT=5000

# Orígenes autorizados a llamar a esta API, separados por comas.
# Déjalo vacío en desarrollo: localhost se permite solo.
CORS_ORIGINS=https://task-manager-front-five.vercel.app

# Coste de bcrypt. Súbelo si el servidor va sobrado, bájalo solo en tests.
BCRYPT_ROUNDS=12

# Saltos de proxy de confianza (Render y Vercel ponen uno delante).
TRUST_PROXY=1
