# Copy to .env and fill in real values. Never commit the .env itself.

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://localhost:27017/task-manager

# Secret used to sign JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a session token stays valid
JWT_EXPIRES_IN=1d

# Port the API listens on
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Leave empty in development to allow localhost.
CORS_ORIGINS=https://task-manager-front-five.vercel.app
